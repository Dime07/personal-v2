---
import ShareIcon from "@icons/shareIcon";
---

<section id="contact" class="bg-white text-black">
  <div
    class="max-w-[1440px] w-full mx-auto px-5 py-20 md:py-28 flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
  >
    <div class="max-w-3xl">
      <h2
        class="text-balance text-4xl font-semibold leading-[0.98] tracking-tight md:text-7xl"
      >
        Hiring a frontend engineer, or have something worth building? Let&apos;s talk.
      </h2>
      <p
        class="mt-5 max-w-xl text-base leading-7 text-black/70 md:text-lg md:leading-8"
      >
        I&apos;m open to connecting with recruiters, product teams, founders, and
        people building useful things for the web. The best way to reach me is
        LinkedIn.
      </p>
    </div>

    <a
      href="https://www.linkedin.com/in/dimas-rafi/"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex w-fit items-center gap-3 rounded-full bg-black px-6 py-4 text-base font-medium text-white transition-transform hover:-translate-y-1"
    >
      Connect on LinkedIn
      <ShareIcon
        className="h-5 w-5 transition-transform group-hover:translate-x-1"
        aria-hidden="true"
      />
    </a>
  </div>
</section>
