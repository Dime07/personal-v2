---
import ShareIcon from "@icons/shareIcon";

const EXPERIENCE_LIST = [
  {
    company: "Digitiket",
    date: "2020",
    position: "Frontend Engineer",
    type: "Internship",
    website: "https://digitiket.com/",
  },
  {
    company: "Radya Labs Teknologi",
    date: "2022",
    position: "Frontend Engineer",
    type: "Internship",
    website: "https://radyadigital.com/id",
  },
  {
    company: "Aksantara Digital",
    date: "2021–2023",
    position: "Frontend Web Developer",
    type: "Freelance",
    website: "https://www.instagram.com/aksantara.digital/",
  },
  {
    company: "Dealls Jobs",
    date: "2023–Present",
    position: "Frontend Engineer",
    type: "Full-time",
    website: "https://dealls.com/",
  },
];
---

<section id="experience" class="bg-black border-t border-white/20 text-white">
  <div class="max-w-[1440px] w-full mx-auto px-5 py-20">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">
          Selected experience
        </h2>
      </div>
      <p class="max-w-sm text-base leading-7 text-white/75">
        Teams, products, and collaborations that have shaped how I build for the
        web.
      </p>
    </div>

    <ol class="mt-12 border-t border-white/20">
      {
        EXPERIENCE_LIST.map((item) => (
          <li class="group grid gap-5 border-b border-white/20 py-7 transition-colors hover:bg-white hover:px-4 hover:text-black md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-8">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-xl font-semibold tracking-tight md:text-2xl">
                  {item.position}
                </h3>
                <span class="rounded-full border border-current/30 px-2.5 py-1 text-xs font-medium">
                  {item.type}
                </span>
              </div>
              <a
                href={item.website}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-current/75 underline-offset-4 hover:underline"
              >
                {item.company}
                <ShareIcon className="h-4 w-4" aria-hidden="true" />
              </a>
            </div>

            <p class="text-sm font-medium text-current/70 md:text-right">
              {item.date}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
