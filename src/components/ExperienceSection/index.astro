---
const EXPERIENCE_LIST = [
  {
    company: "Digitiket",
    date: "2020",
    position: "Frontend Engineer",
    type: "Internship",
    website: "https://digitiket.com/",
  },
  {
    company: "Radya Labs Teknologi",
    date: "2022",
    position: "Frontend Engineer",
    type: "Internship",
    website: "https://radyadigital.com/id",
  },
  {
    company: "Aksantara Digital",
    date: "2021–2023",
    position: "Frontend Web Developer",
    type: "Freelance",
    website: "https://www.instagram.com/aksantara.digital/",
  },
  {
    company: "Dealls Jobs",
    date: "2023–Present",
    position: "Junior Frontend Engineer",
    type: "Full-time",
    website: "https://dealls.com/",
  },
];
---

<section id="experience" class="bg-black border-t border-white/20 text-white">
  <div class="max-w-[1440px] w-full mx-auto px-5 py-20">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-white/60">
          Career path
        </p>
        <h2 class="mt-3 text-3xl font-semibold md:text-5xl">Experience</h2>
      </div>
      <p class="max-w-sm text-sm leading-6 text-white/60">
        A selection of teams and products where I have grown as a frontend
        engineer.
      </p>
    </div>

    <ol class="mt-12 border-t border-white/20">
      {
        EXPERIENCE_LIST.map((item, index) => (
          <li class="group grid gap-5 border-b border-white/20 py-6 transition-colors hover:bg-white hover:px-4 hover:text-black md:grid-cols-[96px_minmax(0,1fr)_auto] md:items-center md:gap-8">
            <p class="font-mono text-sm text-current/60">0{index + 1}</p>

            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-xl font-semibold md:text-2xl">
                  {item.position}
                </h3>
                <span class="rounded-full border border-current/30 px-2.5 py-1 text-xs font-medium">
                  {item.type}
                </span>
              </div>
              <a
                href={item.website}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-2 text-sm text-current/70 underline-offset-4 hover:underline"
              >
                {item.company}
                <span aria-hidden="true">↗</span>
              </a>
            </div>

            <p class="font-mono text-sm text-current/70 md:text-right">
              {item.date}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
