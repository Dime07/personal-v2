---
import MarqueeWrapper from "./MarqueeWrapper";
import HeroHeading from "./HeroHeading";
import Navbar from "@components/Navbar/index.astro";
---

<section
  id="hero"
  class="bg-black shadow min-h-screen flex flex-col overflow-hidden relative pb-[60px] bg-grid-white/[0.2]"
>
  <div
    class="absolute pointer-events-none inset-0 flex items-center justify-center bg-black [mask-image:radial-gradient(ellipse_at_center,transparent_20%,black)]"
  >
  </div>
  <MarqueeWrapper />
  <div class="max-w-[1440px] w-full mx-auto relative z-[2] px-5 flex flex-1 items-center py-12">
    <HeroHeading client:load />
  </div>
  <Navbar />
</section>
