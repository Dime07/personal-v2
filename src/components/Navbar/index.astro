---
const NAVIGATION = [
  { title: "About", href: "#about" },
  { title: "Work", href: "#projects" },
  { title: "Stack", href: "#stack" },
  { title: "Experience", href: "#experience" },
  { title: "Contact", href: "#contact" },
];
---

<nav
  id="navbar"
  class="absolute inset-x-0 bottom-0 z-20 flex h-[60px] w-full items-center justify-center border-y-2 border-white bg-black px-5"
>
  <ul class="flex w-full max-w-[1440px] justify-between">
    {
      NAVIGATION.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm font-medium text-white hover:underline hover:underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4 md:text-xl"
          >
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
