---
import { getCollection } from "astro:content";
import ShareIcon from "@icons/shareIcon";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<section
  id="projects"
  class="bg-black shadow min-h-screen flex flex-col justify-between overflow-hidden relative bg-grid-white/[0.2]"
>
  <div
    class="absolute pointer-events-none inset-0 flex items-center justify-center bg-black [mask-image:radial-gradient(ellipse_at_center,transparent_20%,black)]"
  >
  </div>
  <div
    class="max-w-[1440px] w-full mx-auto relative z-[2] py-20 px-5 text-white grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-4"
  >
    <div
      class="bg-black px-2 py-4 rounded-xl border border-white flex flex-col md:col-span-2 items-center justify-center"
    >
      <h2
        class="max-w-xl text-balance text-center text-3xl font-semibold leading-tight tracking-tight md:text-left md:text-5xl"
      >
        Selected work, built with care and made to be used.
      </h2>
    </div>
    {
      projects.map((project) => (
        <article class="bg-black p-2 rounded-xl border border-white flex flex-col group">
          <img
            src={project.data.thumbnail}
            alt={`Preview of ${project.data.title}`}
            class="w-full object-cover aspect-video h-[200px] md:h-[260px] rounded-md bg-white/10"
            width="600"
            height="338"
            loading="lazy"
          />

          <div class="flex flex-1 flex-col px-1 pt-4 pb-2">
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-2">
                <p class="md:text-2xl text-xl font-semibold">
                  {project.data.title}
                </p>
                <p class="text-xs w-fit bg-white py-1 px-2 text-black rounded-sm inline-flex justify-center items-center font-medium capitalize">
                  {project.data.category.replaceAll("_", " ")}
                </p>
              </div>
              <a
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${project.data.title}`}
                class="shrink-0 rounded-md p-1 transition-colors hover:bg-white hover:text-black"
              >
                <ShareIcon />
              </a>
            </div>

            <p class="mt-4 text-sm leading-6 text-white/70">
              {project.data.description}
            </p>

            <div class="mt-5 flex items-end justify-between gap-4 text-xs text-white/60">
              <div>
                {project.data.role && <p>{project.data.role}</p>}
                <time datetime={project.data.publishedAt.toISOString()}>
                  {project.data.publishedAt.getFullYear()}
                </time>
              </div>
              {project.data.technologies.length > 0 && (
                <ul
                  class="flex flex-wrap justify-end gap-1.5"
                  aria-label="Technologies used"
                >
                  {project.data.technologies.map((technology) => (
                    <li class="rounded-full border border-white/20 px-2 py-1 text-white/80">
                      {technology}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
