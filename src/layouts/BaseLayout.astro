---
import Footer from "../components/Footer/index.astro";
import "@styles/global.css";
const { pageTitle } = Astro.props;
const siteUrl = "https://dimasrafi.my.id";
const description =
  "Dimas Rafi is a Frontend Engineer in Indonesia specializing in React, Next.js, TypeScript, and responsive web experiences. Available to connect for frontend roles and collaborations.";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL("/previewImage.jpg", siteUrl);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dimas Rafi",
  url: siteUrl,
  image: socialImage.href,
  jobTitle: "Frontend Engineer",
  description,
  address: {
    "@type": "PostalAddress",
    addressCountry: "ID",
  },
  sameAs: [
    "https://www.linkedin.com/in/dimas-rafi/",
    "https://www.instagram.com/dime__/",
  ],
  knowsAbout: [
    "Frontend development",
    "React",
    "Next.js",
    "TypeScript",
    "JavaScript",
    "Responsive web design",
    "Web performance",
  ],
};
---

<html lang="en-ID">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Meta tags -->
    <meta
      name="description"
      content={description}
    />
    <meta name="author" content="Dimas Rafi" />
    <meta
      name="keywords"
      content="Dimas Rafi, frontend engineer Indonesia, frontend developer Indonesia, React developer, Next.js developer, TypeScript developer, frontend talent"
    />

    <!-- Google / Search Engine Tags -->
    <meta itemprop="name" content={pageTitle} />
    <meta
      itemprop="description"
      content={description}
    />
    <meta itemprop="image" content={socialImage} />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dimas Rafi" />
    <meta property="og:locale" content="en_ID" />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description}
    />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Dimas Rafi, Frontend Engineer" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{pageTitle}</title></head
  >

  <body class="relative scroll-smooth">
    <slot />
    <Footer />
  </body>
</html>
